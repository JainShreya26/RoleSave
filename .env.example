# Put these values in apps/web/.env.local. Hosted values come from the
# Supabase project settings; local values are printed by `pnpm supabase:start`.
# If .env.local holds hosted values, apps/web/.env.development.local can hold the
# local ones. It overrides .env.local for `pnpm dev`, `pnpm dev:web`, `pnpm dev:worker`,
# `pnpm test:authorization`, and the extension's `build:dev`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key

# Public origin of the web app, no trailing slash. Used for links in auth emails
# (confirm email, reset password) and baked into the extension build for its
# "Forgot password" and "Open saved application" links. Set to the production
# domain when hosting. If unset, the web app derives it from request headers.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100

# Legacy name also supported when migrating an existing local environment:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server/worker only. Never expose this value to the extension or browser.
SUPABASE_SECRET_KEY=replace-with-server-secret-key

# Legacy server key name is also supported:
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-key

# Worker-only. Production always requires an OS-level container. Build the
# default image with `pnpm mhtml:image:build`; Podman is also supported.
MHTML_CONVERTER_RUNTIME=container
MHTML_CONTAINER_ENGINE=docker
MHTML_CONVERTER_IMAGE=rolesave-mhtml-converter:local

# Failed raw payloads are deleted after 7 days; failed job metadata remains
# replayable/auditable for 90 days. Minimums are 1 and 30 respectively.
FAILED_PAYLOAD_RETENTION_DAYS=7
FAILED_JOB_RETENTION_DAYS=90
