{
  "name": "@rolesave/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch --env-file-if-exists=../web/.env.local --env-file-if-exists=../web/.env.development.local src/index.ts",
    "start": "tsx --env-file-if-exists=../web/.env.local src/index.ts",
    "test:authorization": "tsx --env-file-if-exists=../web/.env.local --env-file-if-exists=../web/.env.development.local scripts/verify-authorization.ts",
    "test": "tsx --test src/index.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rolesave/validation": "workspace:*",
    "@supabase/supabase-js": "^2.112.3"
  },
  "devDependencies": {
    "@rolesave/config": "workspace:*",
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^5"
  }
}
